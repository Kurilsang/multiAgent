# ===== LLM Provider API Keys =====
# 只需要填写你实际使用的厂商，留空的厂商不可用
DEEPSEEK_API_KEY=
GLM_API_KEY=
MINIMAX_API_KEY=

# ===== 可选：按厂商覆盖 base_url（留空用默认端点） =====
# 例如 GLM Coding Plan 套餐 Key 只对编码专用端点生效，标准端点会报 1113 余额不足：
# GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
DEEPSEEK_BASE_URL=
GLM_BASE_URL=
MINIMAX_BASE_URL=

# ===== 默认配置 =====
# 默认厂商: deepseek | glm | minimax
LLM_PROVIDER=glm
# 默认模型覆盖（仅对 LLM_PROVIDER 指定的默认厂商生效，避免跨厂商误用模型名；留空用厂商默认模型）
LLM_MODEL=glm-5.3-flash

# 对话上下文的「最近保底」消息条数（不含 system 提示词，最小为 2）。
# 语义（SPEC-0006）：这是**保底下限**而非截断上限——最近 N 条永不被逐出，
# 更早对话在预算允许时逐字入模（预算见下方 CONTEXT_WINDOW_TOKENS）
MAX_CONTEXT_MESSAGES=20

# ===== 上下文预算（docs/specs/0006） =====
# 上下文窗口大小（token，估算口径；默认取三家厂商真实窗口的保守下界）
CONTEXT_WINDOW_TOKENS=32000
# 输出预留（token，给模型生成留位；必须小于窗口）
CONTEXT_OUTPUT_RESERVE_TOKENS=4096

# Agent 任务最大思考轮数（引擎侧硬上限，超过则以 partial 终态收尾，最小为 1）
AGENT_MAX_ITERATIONS=8

# ===== 多 Agent 编排（docs/specs/0004） =====
# 子任务总数上限（派发闸门：跨批累计、含回炉重派；最小为 1）
AGENT_MAX_SUBTASKS=6
# 子任务并行度上限（线程池 worker 数；最小为 1）
AGENT_MAX_PARALLEL=3
# critic 收尾审查开关（默认开：每任务一次审查调用、最多一次整体回炉；置 0 关闭）
AGENT_CRITIC_ENABLED=1

# 工具观察值视图大小：截断时全文旁存句柄池、read_tool_result 续读（0 = 全量直灌）
OBSERVATION_MAX_CHARS=4000

# ===== 技能 =====
# 技能包目录（相对项目根；技能包 = skills/<名称>/SKILL.md）
SKILLS_DIR=skills
# 技能清单注入 system prompt 的条数上限，超出部分用 search_skills 检索（最小为 1）
SKILLS_CATALOG_MAX=30
# 聊天通道迷你工具循环上限：技能激活与依赖工具调用的轮数（最小为 1）
CHAT_MAX_TOOL_TURNS=4

# ===== 会话持久化（docs/specs/0005） =====
# 会话库（相对项目根）：主对话历史落 SQLite，服务重启后仍在；
# 与审计日志分开存放——会话是一等状态，logs/ 是可丢弃留痕
SESSION_DB=data/sessions.db

# ===== MCP =====
# MCP 连接定义文件（相对项目根；条目形态见 docs/specs/0003-mcp-market.md）
MCP_CONFIG=mcp/servers.json
# MCP 工具总数上限：超限在装配期报错提示禁用部分服务（0 = 不限）
MCP_MAX_TOOLS=64
# MCP OAuth token 文件（相对项目根；auth=oauth 服务的授权产物，权限收紧、不入库、不进本文件）
MCP_TOKEN_FILE=mcp/tokens.json
# 技能在线目录爬取服务地址（留空 = 关闭在线目录并隐藏入口；爬取服务自身配置见 services/catalog/README.md）
CATALOG_BASE_URL=http://127.0.0.1:8100
# 本机爬取服务托管：主服务启动时探活失败自动拉起子进程；外部部署/自行管理置 0
CATALOG_AUTOSTART=1

# ===== HTTP API 服务 =====
API_HOST=127.0.0.1
API_PORT=8000
