# ===== LLM Provider API Keys =====
# 只需要填写你实际使用的厂商，留空的厂商不可用
DEEPSEEK_API_KEY=
GLM_API_KEY=
MINIMAX_API_KEY=

# ===== 可选：按厂商覆盖 base_url（留空用默认端点） =====
# 例如 GLM Coding Plan 套餐 Key 只对编码专用端点生效，标准端点会报 1113 余额不足：
# GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
DEEPSEEK_BASE_URL=
GLM_BASE_URL=
MINIMAX_BASE_URL=

# ===== 默认配置 =====
# 默认厂商: deepseek | glm | minimax
LLM_PROVIDER=glm
# 默认模型覆盖（仅对 LLM_PROVIDER 指定的默认厂商生效，避免跨厂商误用模型名；留空用厂商默认模型）
LLM_MODEL=glm-5.3-flash

# 对话上下文最多保留的历史消息条数（不含 system 提示词，最小为 2）
MAX_CONTEXT_MESSAGES=20

# ===== HTTP API 服务 =====
API_HOST=127.0.0.1
API_PORT=8000
